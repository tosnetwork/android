<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- A user may explicitly configure a private/LAN JSON-RPC node by IP address.
         Such nodes commonly expose HTTP only, so cleartext must be permitted at the
         platform layer. App-owned production endpoints remain HTTPS. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
